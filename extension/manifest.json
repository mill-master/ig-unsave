{
  "manifest_version": 3,
  "name": "IG Unsave",
  "version": "0.1.0",
  "description": "Unsaves your saved Instagram posts slowly, one request every 30 to 120 seconds, through Instagram's own page code. No servers, no analytics.",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "alarms"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "IG Unsave" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'none'"
  }
}
